# Next.js (public + server) values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The dev-only mock payment button signs webhooks in the Next.js runtime.
# Set the same PAYMENT_PROVIDER and PAYMENT_WEBHOOK_SECRET as Supabase function
# secrets (use supabase/functions/.env locally).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=

# Read by the Supabase Edge Functions (email + internal auth) and by the Next.js
# cron routes. Use the same CRON_SECRET in Vercel/.env.local and in the Supabase
# function secrets. SITE_URL is used for order links in emails.
RESEND_API_KEY=
EMAIL_FROM="My Store <orders@yourdomain.com>"
SITE_URL=http://localhost:3000

CRON_SECRET=
